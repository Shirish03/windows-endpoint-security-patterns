<?xml version="1.0" encoding="UTF-16"?>
<!--
  BitLockerToGo-Escrow-Retry.sample.xml

  This is an illustrative sample showing the structure of the event-triggered
  scheduled task used by this pattern. It is not intended for direct deployment.

  For the deployable task definition, see:
    tasks/BitLockerToGo-Escrow-Retry.xml

  For deployment, use Install-BTGRecoveryKeyEscrow.ps1, which registers the
  task from the tasks/ XML using schtasks.exe.

  Placeholder values are marked with angle brackets, e.g. <SCRIPT-DEPLOY-PATH>.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>
    <Date><REGISTRATION-DATE></Date>
    <Author>SYSTEM</Author>
    <Description>
      Automatically retries BitLocker-to-Go recovery key escrow when
      a backup failure event (Event ID 846) is detected.
    </Description>
    <URI>\BitLockerToGo-RecoveryKey-Escrow-Retry</URI>
  </RegistrationInfo>

  <Triggers>
    <EventTrigger>
      <Enabled>true</Enabled>
      <!--
        The Subscription is an XML-escaped XPath query embedded as a string.
        Path and Provider must match the correct BitLocker API event channel.
      -->
      <Subscription>
        &lt;QueryList&gt;
          &lt;Query Id="0" Path="Microsoft-Windows-BitLocker-API/Management"&gt;
            &lt;Select Path="Microsoft-Windows-BitLocker-API/Management"&gt;
              *[System[
                Provider[@Name='Microsoft-Windows-BitLocker-API']
                and EventID=846
              ]]
            &lt;/Select&gt;
          &lt;/Query&gt;
        &lt;/QueryList&gt;
      </Subscription>
      <!-- 30-second delay allows Windows to finish writing the event before the script runs -->
      <Delay>PT30S</Delay>
    </EventTrigger>
  </Triggers>

  <Principals>
    <Principal id="SYSTEM">
      <!-- S-1-5-18 = NT AUTHORITY\SYSTEM -->
      <UserId>S-1-5-18</UserId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <!-- IgnoreNew: if a task instance is already running, do not start another -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <!-- Network required: recovery key escrow to Entra ID requires connectivity -->
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- PT5M: a single key escrow retry should complete well within 5 minutes -->
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions Context="SYSTEM">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>
        -NoProfile -ExecutionPolicy Bypass
        -File "&lt;SCRIPT-DEPLOY-PATH&gt;\BTG_RecoveryKey_Escrow_Retry.ps1"
      </Arguments>
    </Exec>
  </Actions>

</Task>
